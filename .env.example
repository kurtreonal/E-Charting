# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_HOST=localhost
DB_USER=charting_user
DB_PASS=your_secure_database_password_here
DB_NAME=e_charting
DB_CHARSET=utf8mb4

# ========================================
# TIMEZONE
# ========================================
APP_TIMEZONE=Asia/Manila

# ========================================
# EMAIL CONFIGURATION (SMTP)
# ========================================
# Supported: gmail, mailtrap, custom
MAIL_DRIVER=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# ========================================
# FROM EMAIL ADDRESS
# ========================================
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Mica Hospital

# ========================================
# HOSPITAL INFORMATION
# ========================================
HOSPITAL_NAME=Mica Hospital
HOSPITAL_ADDRESS=123 Health St., Etivac City, HC 45678
HOSPITAL_PHONE=0939-123-4567
HOSPITAL_EMAIL=hospital@example.com
HOSPITAL_WEBSITE=http://localhost/E-Charting

# ========================================
# SECURITY SETTINGS
# ========================================
APP_DEBUG=false
APP_ENV=production
SESSION_TIMEOUT=1800

# ========================================
# SESSION CONFIGURATION
# ========================================
SESSION_LIFETIME=1800
SESSION_REGENERATE_ON_LOGIN=true
